# --- Database ---------------------------------------------------------------
# Leave unset (or "pglite:./.data/pglite") to use the embedded local Postgres.
# For Neon, use the pooled connection string:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/gst_itc?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/gst_itc?sslmode=require"

# --- Email (MVP: Mailpit; run `docker compose up -d mailpit`) -------------------
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="GST Compliance <compliance@demomfg.example>"
