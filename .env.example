# --- Database ---------------------------------------------------------------
# Leave unset (or "pglite:./.data/pglite") to use the embedded local Postgres.
# For Neon, use the pooled connection string:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/gst_itc?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/gst_itc?sslmode=require"

# --- Email (MVP: Mailpit; run `docker compose up -d mailpit`) -------------------
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="GST Compliance <compliance@demomfg.example>"
# EMAIL_REPLY_TO=finance@demomfg.example

# Base URL used in vendor statement links
APP_BASE_URL=http://localhost:3000

# --- WhatsApp (MVP: mirrored into Mailpit, no provider) -------------------------
# mailpit (default) | memory | none
WHATSAPP_TRANSPORT=mailpit
# Required by /api/webhooks/whatsapp once a real provider posts to it (always in production)
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# --- API ----------------------------------------------------------------------------
# No login yet (Day 13). "dev" (the default outside production) trusts the
# x-organization-id header, or uses the only organization. Production refuses API calls.
# AUTH_MODE=dev
# Real GSTR-2B downloads for the mock GSP: <dir>/<GSTIN>/<MMYYYY>.json
# GSP_FIXTURES_DIR=./fixtures/gstr2b
